<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pushes a Claude Code usage snapshot to shifan.me's footer, hourly.

  The script deliberately lives in ~/.local/bin, NOT in the repo under
  ~/Documents: a LaunchAgent cannot read ~/Documents without macOS Full
  Disk Access, and the earlier repo-based version failed every run with
  "Operation not permitted".

  Install:  launchctl load ~/Library/LaunchAgents/me.shifan.usage-push.plist
  Remove:   launchctl unload ~/Library/LaunchAgents/me.shifan.usage-push.plist
  Run now:  ~/.local/bin/shifan-usage-push.sh
  Log:      tail -f /tmp/shifan-usage-push.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.shifan.usage-push</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/shifanhirani/.local/bin/shifan-usage-push.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/tmp</string>
    <key>StandardOutPath</key>
    <string>/tmp/shifan-usage-push.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/shifan-usage-push.err</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
