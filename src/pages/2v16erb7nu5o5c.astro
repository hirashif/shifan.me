---
import Base from '../layouts/Base.astro';
---
<Base title="resume" description="">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <a href="/" class="mono" style="font-size:12.5px;color:var(--fg3);text-decoration:none">
    ← back to shifan.me
  </a>
  <object data="/resume.pdf" type="application/pdf"
          style="width:100%;height:80vh;border:1px solid var(--line);border-radius:10px">
    <p style="font-size:15px;color:var(--fg2)">
      your browser will not display this inline.
      <a href="/resume.pdf" style="color:var(--accText)">open the pdf</a>.
    </p>
  </object>
  <a href="/resume.pdf" class="mono"
     style="font-size:12.5px;color:var(--accText);text-decoration:none">open the pdf →</a>
</Base>
