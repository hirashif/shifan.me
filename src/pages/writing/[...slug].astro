---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtMonth } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.excerpt}>
  <a href="/writing" class="mono back-link">← writing</a>

  <article class="fade-up">
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="post-meta mono">
        <span class="post-tag">{post.data.tag}</span>
        <span>{post.data.minutes} min</span>
        <span>{fmtMonth(post.data.date)}</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back-link {
    font-size: 12.5px;
    color: var(--fg3);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--fg);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .post-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .post-meta {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
    color: var(--fg3);
  }
  .post-tag {
    color: var(--accText);
  }

  .prose {
    font-size: 16px;
    line-height: 1.75;
    color: var(--fg2);
  }
  .prose :global(p) {
    margin: 0 0 20px;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 32px 0 12px;
    color: var(--fg);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .prose :global(h2) {
    font-size: 22px;
  }
  .prose :global(h3) {
    font-size: 18px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 20px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li:last-child) {
    margin-bottom: 0;
  }
  .prose :global(a) {
    color: var(--accText);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--acc) 40%, transparent);
    transition: text-decoration-color 0.15s;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--acc);
  }
  .prose :global(code) {
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.88em;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 6px;
  }
  .prose :global(pre) {
    margin: 0 0 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .prose :global(blockquote) {
    margin: 0 0 20px;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    color: var(--fg3);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 25px;
    }
    .post-meta {
      flex-wrap: wrap;
      gap: 8px 12px;
    }
  }
  @media (max-width: 420px) {
    h1 {
      font-size: 22px;
    }
    .prose {
      font-size: 15px;
    }
  }
</style>
