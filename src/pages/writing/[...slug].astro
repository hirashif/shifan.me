---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtMonth } from '../../lib/date';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.excerpt} type="article">
  <a href="/writing" class="mono back-link">← writing</a>

  <article class="fade-up">
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="post-meta mono">
        <span class="post-tag">{post.data.tag}</span>
        <span>{post.data.minutes} min</span>
        <span>{fmtMonth(post.data.date)}</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back-link {
    font-size: 12.5px;
    color: var(--fg3);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--fg);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .post-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .post-meta {
    display: flex;
    gap: 12px;
    font-size: 11.5px;
    color: var(--fg3);
  }
  .post-tag {
    color: var(--accText);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 25px;
    }
    .post-meta {
      flex-wrap: wrap;
      gap: 8px 12px;
    }
  }
  @media (max-width: 420px) {
    h1 {
      font-size: 22px;
    }
  }
</style>
