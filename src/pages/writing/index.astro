---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/date';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = ['all', ...new Set(posts.map((p) => p.data.tag))];
---
<Base title="writing">
  <a href="/" class="mono back-link">← shifan</a>

  <header class="fade-up">
    <h1>writing</h1>
    <p class="sub">
      long-form when something broke and i want to remember why. for the one-liners, see{' '}
      <a href="/learnings" class="learned-link">things i've learned</a>.
    </p>
    <div class="chips">
      {tags.map((tag, i) => (
        <button type="button" data-tag={tag} class="mono chip" aria-pressed={i === 0 ? 'true' : 'false'}>
          {tag}
        </button>
      ))}
    </div>
  </header>

  <section class="rows fade-up" style="animation-delay:100ms">
    {posts.map((post) => (
      <a href={`/writing/${post.id}`} data-post data-post-tag={post.data.tag} class="row">
        <div class="row-top">
          <span class="row-title">{post.data.title}</span>
          <span class="row-date mono">{fmtDate(post.data.date)}</span>
        </div>
        <div class="row-excerpt">{post.data.excerpt}</div>
        <div class="row-meta mono">
          <span class="row-tag">{post.data.tag}</span>
          <span>{post.data.minutes} min</span>
        </div>
      </a>
    ))}
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const rows = document.querySelectorAll<HTMLAnchorElement>('[data-post]');

  function select(tag: string) {
    chips.forEach((chip) => {
      const active = chip.dataset.tag === tag;
      chip.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    rows.forEach((row) => {
      const show = tag === 'all' || row.dataset.postTag === tag;
      row.hidden = !show;
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => select(chip.dataset.tag ?? 'all'));
  });
</script>

<style>
  .back-link {
    font-size: 12.5px;
    color: var(--fg3);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--fg);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .sub {
    margin: 0;
    font-size: 16px;
    color: var(--fg2);
    line-height: 1.5;
  }
  .learned-link {
    color: var(--accText);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(232, 176, 75, 0.4);
    transition: text-decoration-color 0.15s;
  }
  .learned-link:hover {
    text-decoration-color: var(--acc);
  }

  .chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .chip {
    all: unset;
    cursor: pointer;
    font-size: 12px;
    padding: 4px 9px;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--fg3);
    box-sizing: border-box;
    transition: border-color 0.15s, color 0.15s;
  }
  .chip:hover {
    border-color: var(--acc);
    color: var(--fg);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--acc);
    color: var(--fg);
  }

  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 12px;
    margin: 0 -12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.15s;
  }
  .row:hover {
    background: var(--hov);
  }
  .row-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
  }
  .row-title {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .row-date {
    font-size: 11.5px;
    color: var(--fg3);
    white-space: nowrap;
  }
  .row-excerpt {
    font-size: 14.5px;
    color: var(--fg2);
    line-height: 1.5;
  }
  .row-meta {
    display: flex;
    gap: 12px;
    font-size: 11px;
    color: var(--fg3);
  }
  .row-tag {
    color: var(--accText);
  }
</style>
