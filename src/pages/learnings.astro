---
import Base from '../layouts/Base.astro';
import { learnings } from '../content/learnings';
---
<Base title="things i've learned">
  <a href="/" class="mono back-link">← shifan</a>

  <header class="fade-up">
    <h1>things i've learned</h1>
    <p class="sub">twenty-five. one line each. when i learn a new one, an old one has to go.</p>
  </header>

  <ol class="list fade-up" style="animation-delay:100ms">
    {learnings.map((text, i) => (
      <li data-learning>
        <span data-learning-num class="mono num">{String(i + 1).padStart(2, '0')}</span>
        <span class="text">{text}</span>
      </li>
    ))}
  </ol>
</Base>

<style>
  .back-link {
    font-size: 12.5px;
    color: var(--fg3);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--fg);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .sub {
    margin: 0;
    font-size: 16px;
    color: var(--fg2);
    line-height: 1.5;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid var(--line);
  }
  .num {
    font-size: 12px;
    color: var(--accText);
  }
  .text {
    font-size: 16px;
    line-height: 1.5;
  }
</style>
