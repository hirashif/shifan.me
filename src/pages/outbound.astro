---
// /outbound/: a case study, indexed and in the sitemap like the writing posts,
// and listed in the home page's writing section (see index.astro). Not in the
// dock. Its url is already in emails, so it stays at /outbound/. The text is his, rendered
// verbatim from src/content/outbound.md; edit it there, never retype it here.
// It keeps its own sentence case, an approved exception to the lowercase rule.
import Base from '../layouts/Base.astro';
import '../styles/prose.css';
import { Content, getHeadings } from '../content/outbound.md';

const title = getHeadings()[0]?.text ?? '';
---
<Base title={title} description="This is what I built, what broke, and the numbers so far." type="article">
  <a href="/" class="mono back-link">← back to shifan.me</a>
  <article class="prose outbound fade-up">
    <Content />
  </article>
</Base>

<style>
  .back-link {
    font-size: 12.5px;
    color: var(--fg3);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--fg);
  }

  /* Title and date come from the markdown itself, styled to match a post's
     header: the h1 like a post title, the italic date line like its meta row. */
  .outbound :global(h1) {
    margin: 0 0 10px;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--fg);
  }
  .outbound :global(h1 + p) {
    margin-bottom: 28px;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--fg3);
  }
  .outbound :global(h1 + p em) {
    font-style: normal;
  }
  .outbound :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .outbound :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 36px 0 20px;
  }
  .outbound :global(hr + p) {
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--fg3);
  }

  /* The funnel table: hairline rows, no boxes. */
  .outbound :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.55;
  }
  .outbound :global(th) {
    text-align: left;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--fg3);
    padding: 0 16px 8px 0;
  }
  .outbound :global(td) {
    padding: 12px 16px 12px 0;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .outbound :global(th:last-child),
  .outbound :global(td:last-child) {
    padding-right: 0;
  }
  .outbound :global(td:first-child) {
    width: 46%;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .outbound :global(h1) {
      font-size: 25px;
    }
    /* Stack each row: the stage becomes a small label above its result. */
    .outbound :global(thead) {
      display: none;
    }
    .outbound :global(table),
    .outbound :global(tbody),
    .outbound :global(tr),
    .outbound :global(td) {
      display: block;
      width: 100%;
    }
    .outbound :global(tr) {
      border-top: 1px solid var(--line);
      padding: 12px 0;
    }
    .outbound :global(td) {
      border-top: 0;
      padding: 0;
    }
    .outbound :global(td:first-child) {
      width: 100%;
      margin-bottom: 4px;
      font-size: 13px;
      color: var(--fg3);
    }
    .outbound :global(td:last-child) {
      color: var(--fg);
    }
  }
  @media (max-width: 420px) {
    .outbound :global(h1) {
      font-size: 22px;
    }
  }
</style>
