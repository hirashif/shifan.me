---
import { education } from '../content/education';
---
<div class="education">
  {education.map((e) => (
    <div data-education-row class="education-row">
      <div class="row-main">
        {e.logo && <img class="row-logo" src={e.logo} alt={e.school} width="17" height="17" loading="lazy" />}
        <div>
          <div class="row-title">{e.school} <span class="row-degree">— {e.degree}</span></div>
          {e.note && <div class="row-note">{e.note}</div>}
        </div>
      </div>
      <span class="row-meta mono tnum">{e.meta}</span>
    </div>
  ))}
</div>

<style>
  .education {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .education-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
  }
  .row-main {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .row-logo {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    object-fit: contain;
    margin-top: 1px;
    flex-shrink: 0;
  }
  .row-title {
    font-size: 14.5px;
    font-weight: 500;
  }
  .row-degree {
    color: var(--fg2);
    font-weight: 400;
  }
  .row-note {
    font-size: 13px;
    color: var(--fg2);
    line-height: 1.5;
    margin-top: 2px;
  }
  .row-meta {
    font-size: 11.5px;
    color: var(--fg3);
    padding-top: 2px;
  }

  @media (max-width: 420px) {
    .education-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .row-meta {
      padding-top: 0;
    }
  }
</style>
