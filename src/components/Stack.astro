---
// Stack chip icons are bundled from the local `simple-icons` package (not
// hotlinked from a CDN) per design_handoff/README.md § Assets. Each icon is
// pulled in as a raw string via Vite's `?raw` import — resolved and inlined
// at build time, so nothing reads the filesystem at request time (required
// for the Cloudflare Workers runtime, which has no filesystem at all).
import { stack } from '../content/stack';
import goSvg from '../../node_modules/simple-icons/icons/go.svg?raw';
import openjdkSvg from '../../node_modules/simple-icons/icons/openjdk.svg?raw';
import pythonSvg from '../../node_modules/simple-icons/icons/python.svg?raw';
import typescriptSvg from '../../node_modules/simple-icons/icons/typescript.svg?raw';
import postgresqlSvg from '../../node_modules/simple-icons/icons/postgresql.svg?raw';
import apachekafkaSvg from '../../node_modules/simple-icons/icons/apachekafka.svg?raw';
import redisSvg from '../../node_modules/simple-icons/icons/redis.svg?raw';
import springbootSvg from '../../node_modules/simple-icons/icons/springboot.svg?raw';
import kubernetesSvg from '../../node_modules/simple-icons/icons/kubernetes.svg?raw';
import dockerSvg from '../../node_modules/simple-icons/icons/docker.svg?raw';
import claudeSvg from '../../node_modules/simple-icons/icons/claude.svg?raw';
import cursorSvg from '../../node_modules/simple-icons/icons/cursor.svg?raw';
import opencodeSvg from '../../node_modules/simple-icons/icons/opencode.svg?raw';
import reactSvg from '../../node_modules/simple-icons/icons/react.svg?raw';

const ICONS: Record<string, string> = {
  go: goSvg,
  openjdk: openjdkSvg,
  python: pythonSvg,
  typescript: typescriptSvg,
  postgresql: postgresqlSvg,
  apachekafka: apachekafkaSvg,
  redis: redisSvg,
  springboot: springbootSvg,
  kubernetes: kubernetesSvg,
  docker: dockerSvg,
  claude: claudeSvg,
  cursor: cursorSvg,
  opencode: opencodeSvg,
  react: reactSvg,
};

function iconPath(slug: string): string | null {
  const raw = ICONS[slug];
  if (!raw) return null;
  const match = raw.match(/<path d="([^"]+)"/);
  if (!match) throw new Error(`simple-icons: no path found for slug "${slug}"`);
  return match[1];
}
---
<ul class="chips">
  {stack.map((s) => {
    const path = iconPath(s.slug);
    return (
      <li class="chip">
        {path && (
          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d={path}></path></svg>
        )}
        <span>{s.label}</span>
      </li>
    );
  })}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--fg2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 9px;
    box-sizing: border-box;
  }
</style>
