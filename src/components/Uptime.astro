---
import { calcUptime } from './uptime';
const initial = calcUptime();
---
<div class="uptime-wrap mono tnum">uptime<br class="uptime-break" /><span data-uptime class="uptime-value tnum">{initial}</span> yrs</div>

<style>
  .uptime-wrap {
    text-align: right;
    font-size: 12px;
    color: var(--fg3);
    line-height: 1.6;
  }
  .uptime-value {
    color: var(--fg);
    font-size: 15px;
  }
  @media (max-width: 640px) {
    .uptime-wrap {
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .uptime-break {
      display: none;
    }
  }
</style>

<script>
  import { initUptime } from './uptime';
  initUptime();
</script>
