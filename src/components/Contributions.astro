---
interface Props {
  delay?: number;
}
const { delay = 80 } = Astro.props;

// This page is static-prerendered (no `prerender = false` here — the live
// data has to come from /api/contributions at request time, via the client
// script below, not from this frontmatter). So the grid ships with a blank
// (level-0) placeholder of a typical year's shape — 53 weeks, 7 rows — to
// reserve its footprint from first paint. The client script recolors these
// same nodes once real data arrives; because the row count (7) and cell
// size are fixed by CSS, swapping placeholder cells for real ones (even a
// week or two off in column count) never changes the section's height, so
// it never shifts layout on the common "it worked" path. Only the rare
// failure path (GitHub unreachable, empty response) collapses the section,
// which is the one case where a shift is unavoidable.
const PLACEHOLDER_WEEKS = 53;
const placeholderCells = Array.from({ length: PLACEHOLDER_WEEKS * 7 });
---

<section
  id="contributions"
  class="fade-up"
  style={`animation-delay:${delay}ms`}
  data-contrib-section
>
  <div class="section-label">contributions</div>
  <div class="contrib-wrap">
    <div class="contrib-grid" data-contrib-grid>
      {placeholderCells.map(() => <span class="contrib-cell" data-contrib-placeholder></span>)}
    </div>
  </div>
</section>

<style>
  .section-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg3);
    padding-bottom: 8px;
  }
  /* Horizontal scroller so a full year (~53 weeks) never forces the page
     itself to overflow at narrow widths — only this strip scrolls. */
  .contrib-wrap {
    overflow-x: auto;
    padding-bottom: 2px;
  }
  .contrib-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 10px);
    grid-auto-columns: 10px;
    gap: 3px;
    width: max-content;
  }
  .contrib-grid :global(.contrib-cell) {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--cellEmpty);
  }

  @media (max-width: 640px) {
    .contrib-grid {
      grid-template-rows: repeat(7, 9px);
      grid-auto-columns: 9px;
      gap: 2.5px;
    }
    .contrib-grid :global(.contrib-cell) {
      width: 9px;
      height: 9px;
    }
  }
</style>

<script>
  import { initContributions } from './contributions';
  initContributions();
</script>
