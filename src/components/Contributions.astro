---
interface Props {
  delay?: number;
}
const { delay = 80 } = Astro.props;

// This page is static-prerendered (no `prerender = false` here — the live
// data has to come from /api/contributions at request time, via the client
// script below, not from this frontmatter). So the grid ships with a blank
// (level-0) placeholder shaped like the trimmed window the API now returns
// — 26 weeks (last ~6 months), 7 rows — to reserve its footprint from first
// paint. See WINDOW_WEEKS in src/lib/contributions.ts, which this mirrors;
// kept as a literal here (Astro frontmatter is server-only and this file
// has no other reason to import that module) rather than duplicated as a
// shared import. The client script recolors these same nodes once real
// data arrives; because the row count (7) and column count are fixed by
// CSS, swapping placeholder cells for real ones (even a week off in column
// count) never changes the section's footprint, so it never shifts layout
// on the common "it worked" path. Only the rare failure path (GitHub
// unreachable, empty response) collapses the section, which is the one
// case where a shift is unavoidable.
const PLACEHOLDER_WEEKS = 26;
const placeholderCells = Array.from({ length: PLACEHOLDER_WEEKS * 7 });
---

<section
  id="contributions"
  class="fade-up"
  style={`animation-delay:${delay}ms`}
  data-contrib-section
>
  <div class="section-label">contributions</div>
  <div class="contrib-wrap">
    <div class="contrib-grid" data-contrib-grid>
      {placeholderCells.map(() => <span class="contrib-cell" data-contrib-placeholder></span>)}
    </div>
  </div>
</section>

<style>
  .section-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg3);
    padding-bottom: 8px;
  }
  /* At the full year's ~53 columns this needed to scroll horizontally on
     its own so it wouldn't force the page itself to overflow at narrow
     widths. Trimmed to 26 columns (last ~6 months, see WINDOW_WEEKS in
     src/lib/contributions.ts) the grid is sized to fill the content column
     exactly instead: 26 fixed `1fr` column tracks always divide the full
     available width evenly, so the grid spans edge to edge at any
     viewport — the 600px desktop content area (inside <main>'s 680px
     border-box and 40px side padding), the 343px phone content area at
     375px, and everything in between (including the 641-759px range where
     the outer column is still growing toward its cap) — without a fixed
     pixel size ever falling out of sync with the container at some
     in-between width. Cells are square via `aspect-ratio: 1` on a
     100%-wide cell, so height always follows the computed column width
     rather than a hardcoded px value — never a stretched rectangle, and no
     horizontal scroll is ever needed since the grid never exceeds its
     container. See WINDOW_WEEKS in src/lib/contributions.ts for the full
     arithmetic behind landing on 26 weeks specifically (~20px cells at
     600px, ~11px at 343px, both measured directly, not estimated).
  */
  .contrib-wrap {
    padding-bottom: 2px;
  }
  .contrib-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: repeat(26, 1fr);
    grid-template-rows: repeat(7, auto);
    gap: 3px;
    width: 100%;
  }
  .contrib-grid :global(.contrib-cell) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--cellEmpty);
  }

  /* Narrow phones: a smaller fixed gap leaves a bit more of the column
     width for the cells themselves (still legible at ~11px, see the
     WINDOW_WEEKS comment), rather than eating into it evenly with the
     desktop gap. */
  @media (max-width: 420px) {
    .contrib-grid {
      gap: 2px;
    }
  }
</style>

<script>
  import { initContributions } from './contributions';
  initContributions();
</script>
