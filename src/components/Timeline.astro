---
import { work } from '../content/work';
---
<div class="timeline">
  {work.map((w) => (
    <div data-work-row class="timeline-row">
      {w.logo && !w.isCurrent ? (
        <span class="logo-badge">
          <img class="row-logo" src={w.logo} alt={w.title} width="16" height="16" loading="lazy" />
        </span>
      ) : (
        <span class:list={['dot', { 'dot-current': w.isCurrent }]}></span>
      )}
      <div>
        <div class="row-title">{w.title} <span class="row-role">— {w.role}</span></div>
        <div class="row-desc">{w.desc}</div>
      </div>
      <span class:list={['row-date', 'mono', 'tnum', { 'row-date-current': w.isCurrent }]}>
        {w.isCurrent ? 'now' : w.dates}
      </span>
    </div>
  ))}
</div>

<style>
  .timeline {
    /* rail-x = center of the border-left line, relative to a row's content
       edge: -(border-width + padding-left) + border-width / 2. Keep this in
       sync with padding-left below (and its media-query overrides) so the
       dot/logo stay centred on the rail at every breakpoint. */
    --rail-x: -22.5px;
    display: flex;
    flex-direction: column;
    position: relative;
    padding-left: 22px;
    border-left: 1px solid var(--line);
    gap: 22px;
  }
  .timeline-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
  }
  .dot {
    position: absolute;
    left: var(--rail-x);
    top: 10.5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-sizing: border-box;
    background: var(--bg);
    border: 1.5px solid var(--fg3);
    transform: translate(-50%, -50%);
  }
  .dot-current {
    background: var(--acc);
    border: none;
    animation: pulse 1.8s ease-out infinite;
  }
  .logo-badge {
    position: absolute;
    left: var(--rail-x);
    top: 10.5px;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
  }
  .row-logo {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    object-fit: contain;
  }
  .row-title {
    font-size: 16px;
    font-weight: 500;
  }
  .row-role {
    color: var(--fg2);
    font-weight: 400;
  }
  .row-desc {
    font-size: 14px;
    color: var(--fg2);
    line-height: 1.5;
    margin-top: 2px;
  }
  .row-date {
    font-size: 12px;
    color: var(--fg3);
    padding-top: 3px;
  }
  .row-date-current {
    color: var(--accText);
  }

  @media (max-width: 640px) {
    .timeline {
      --rail-x: -20.5px;
      padding-left: 20px;
      gap: 20px;
    }
    .timeline-row {
      grid-template-columns: 1fr;
      gap: 3px;
    }
    .row-date {
      order: -1;
      padding-top: 0;
    }
  }
</style>
