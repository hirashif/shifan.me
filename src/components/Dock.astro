---
// Icon markup below is copied verbatim (paths, viewBoxes, stroke widths) from
// the approved prototype at design_handoff/Home.dc.html, inside its dock <nav>.
const ICONS: Record<string, string> = {
  pencil:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20h4l11-11-4-4L4 16v4z"></path></svg>',
  bulb:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6"></path><path d="M10 21h4"></path><path d="M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.3 1 2.5h6c0-1.2.4-1.9 1-2.5A6 6 0 0 0 12 3z"></path></svg>',
  squares:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>',
  github:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55v11.45z"></path></svg>',
  mail:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect><path d="M3.5 6.5 12 13l8.5-6.5"></path></svg>',
  sun:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>',
  moon:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>',
};

const path = Astro.url.pathname;
const active = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const items = [
  { href: '/', label: 'home', text: '/' },
  { href: '/writing', label: 'writing', icon: 'pencil' },
  { href: '/learnings', label: 'learnings', icon: 'bulb' },
  { href: '/plot', label: 'the plot', icon: 'squares' },
];
---
<nav aria-label="site" style="position:sticky;bottom:20px;align-self:center;margin:24px 0 20px;padding:6px;display:flex;gap:2px;border-radius:12px;background:var(--dock);border:1px solid var(--dockLine);box-shadow:var(--shadow);backdrop-filter:blur(12px);animation:dockIn .7s .4s both">
  {items.map((it) => (
    <a href={it.href} aria-label={it.label} data-tip={it.label}
       class:list={['dock-item', { 'is-active': active(it.href) }]}>
      {it.text ?? <Fragment set:html={ICONS[it.icon!]} />}
      {active(it.href) && <span class="dot" aria-hidden="true"></span>}
    </a>
  ))}
  <span class="divider" aria-hidden="true"></span>
  <a href="https://github.com/hirashif" aria-label="github" data-tip="github" class="dock-item" target="_blank" rel="noopener"><Fragment set:html={ICONS.github} /></a>
  <a href="https://linkedin.com/in/shifanhirani" aria-label="linkedin" data-tip="linkedin" class="dock-item" target="_blank" rel="noopener"><Fragment set:html={ICONS.linkedin} /></a>
  <button type="button" aria-label="copy email" data-tip="copy email" data-copy-email class="dock-item"><Fragment set:html={ICONS.mail} /></button>
  <button type="button" aria-label="toggle theme" data-tip="toggle theme" data-theme-toggle class="dock-item">
    <span data-theme-icon="dark"><Fragment set:html={ICONS.sun} /></span>
    <span data-theme-icon="light" style="display:none"><Fragment set:html={ICONS.moon} /></span>
  </button>
</nav>

<style>
  .dock-item {
    position:relative; width:38px; height:38px; border-radius:8px;
    display:grid; place-items:center; color:var(--fg2);
    text-decoration:none; background:none; border:0; cursor:pointer;
    font-size:13px; font-weight:600;
    transition: transform .4s cubic-bezier(.34,1.56,.64,1), background .15s, color .15s;
  }
  .dock-item:hover { background:var(--hov); color:var(--fg); transform:translateY(-7px) scale(1.18); }
  .dock-item.is-active { color:var(--fg); }
  .dock-item .dot { position:absolute; bottom:3px; width:4px; height:4px; border-radius:50%; background:var(--acc); }
  .dock-item::after {
    content: attr(data-tip);
    position:absolute; bottom:calc(100% + 12px); left:50%; transform:translateX(-50%) translateY(4px);
    background:var(--fg); color:var(--bg); font-size:11px; font-weight:500;
    padding:5px 9px; border-radius:6px; white-space:nowrap;
    opacity:0; pointer-events:none; transition:opacity .15s, transform .25s;
  }
  .dock-item:hover::after { opacity:1; transform:translateX(-50%) translateY(0); }
  .divider { width:1px; background:var(--dockLine); margin:6px 4px; }
  .copied-bubble {
    position:absolute; bottom:calc(100% + 12px); left:50%; transform:translateX(-50%);
    padding:4px 8px; border-radius:6px; background:var(--fg); color:var(--bg);
    font-size:11px; white-space:nowrap; animation:pop .18s ease-out both;
  }
</style>

<script>
  import { initTheme, initShortcuts } from './dock';
  initTheme();
  initShortcuts();

  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  btn?.addEventListener('click', async () => {
    const address = ['shifan.hirani', 'gmail.com'].join('@');
    try { await navigator.clipboard.writeText(address); } catch { return; }
    const bubble = document.createElement('span');
    bubble.textContent = 'copied';
    bubble.className = 'copied-bubble';
    btn.appendChild(bubble);
    setTimeout(() => bubble.remove(), 1400);
  });
</script>
