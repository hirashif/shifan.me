---
import { CELLS, PALETTE, cellToCoord } from '../lib/coords';

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;

const cells = Array.from({ length: CELLS }, (_, i) => i);
---

<div class="plot" data-plot-root data-plot-full={full ? 'true' : 'false'}>
  <div class="grid" data-plot-grid>
    {cells.map((i) => (
      <button type="button" data-cell={i} class="cell" aria-label={`${cellToCoord(i)}, empty`}></button>
    ))}
  </div>
  <div class="tooltip" data-plot-tooltip hidden>
    <div class="tooltip-row">
      <span class="tooltip-swatch" data-tooltip-swatch></span>
      <span data-tooltip-msg></span>
    </div>
    <div class="tooltip-meta mono" data-tooltip-meta></div>
  </div>
</div>

<div class="claimed-line mono" data-plot-claimed hidden>
  yours is at <span class="claimed-coord" data-plot-claimed-coord></span>. it stays.
</div>

<div class="claim-bar" data-plot-claim-bar>
  <div class="swatches">
    {PALETTE.map((hex, i) => (
      <button type="button" class="swatch" data-swatch={i} style={`background:${hex}`} aria-label={`pick color ${i + 1}`}></button>
    ))}
  </div>
  <input type="text" class="field" data-plot-name placeholder="name" maxlength="40" autocomplete="off" />
  <input type="text" class="field" data-plot-msg placeholder="one line" maxlength="120" autocomplete="off" />
  <div class="claim-actions">
    <button type="button" class="claim-btn" data-plot-claim-btn hidden>claim</button>
    <button type="button" class="cancel-btn" data-plot-cancel aria-label="cancel" hidden>×</button>
  </div>
</div>

<div class="error-line mono" data-plot-error hidden></div>

{full && (
  <section class="recent-section">
    <div class="recent-label">recent</div>
    <div data-plot-recent class="recent-list"></div>
  </section>
)}

<style>
  .plot {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(40, 1fr);
    gap: 2px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    box-sizing: border-box;
  }
  [data-plot-full='true'] .grid {
    padding: 12px;
    border-radius: 12px;
  }
  .cell {
    all: unset;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--cellEmpty);
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.12s, background 0.2s;
  }
  .cell:hover {
    position: relative;
    z-index: 2;
    transform: scale(1.35);
  }
  .cell[data-filled] {
    cursor: help;
  }
  .cell[data-pending] {
    position: relative;
    z-index: 2;
    transform: scale(1.35);
    outline: 2px solid var(--fg);
  }

  .tooltip {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    transform: translate(-50%, -100%);
    width: max-content;
    max-width: 260px;
    padding: 9px 12px;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    box-shadow: var(--shadow);
    animation: pop 0.14s ease-out both;
  }
  .tooltip-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 1.4;
  }
  .tooltip-swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex: none;
    background: var(--cellEmpty);
  }
  .tooltip-meta {
    font-size: 10.5px;
    opacity: 0.6;
    margin-top: 3px;
  }

  .claimed-line {
    font-size: 13px;
    color: var(--fg3);
  }
  .claimed-coord {
    color: var(--accText);
  }

  .claim-bar {
    display: grid;
    grid-template-columns: auto 1fr 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 12px 14px;
    border: 1px dashed var(--dockLine);
    border-radius: 10px;
    box-sizing: border-box;
  }
  .swatches {
    display: flex;
    gap: 5px;
  }
  .swatch {
    all: unset;
    cursor: pointer;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    box-sizing: border-box;
    outline-offset: 2px;
    transition: transform 0.12s;
  }
  .swatch:hover {
    transform: scale(1.15);
  }
  .swatch[data-selected] {
    outline: 2px solid var(--fg);
  }
  .field {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--hov);
    color: var(--fg);
    font-size: 13.5px;
  }
  .claim-actions {
    display: flex;
    gap: 6px;
  }
  .claim-btn {
    border: 0;
    cursor: pointer;
    padding: 7px 12px;
    border-radius: 8px;
    background: var(--acc);
    color: #1a1a1a;
    font-size: 13px;
    font-weight: 600;
    transition: transform 0.15s;
  }
  .claim-btn:hover {
    transform: translateY(-1px);
  }
  .claim-btn[disabled] {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }
  .cancel-btn {
    border: 1px solid var(--dockLine);
    cursor: pointer;
    padding: 7px 10px;
    border-radius: 8px;
    background: none;
    color: var(--fg2);
    font-size: 13px;
  }
  .cancel-btn:hover {
    color: var(--fg);
  }

  .error-line {
    font-size: 12.5px;
    color: var(--fg2);
  }

  .recent-section {
    display: flex;
    flex-direction: column;
  }
  .recent-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg3);
    padding-bottom: 8px;
  }
  .recent-list {
    display: flex;
    flex-direction: column;
  }
  .recent-list :global(.recent-row) {
    display: grid;
    grid-template-columns: 14px 44px 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 11px 0;
    border-top: 1px solid var(--line);
  }
  .recent-list :global(.recent-swatch) {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    align-self: center;
  }
  .recent-list :global(.recent-coord) {
    font-size: 11.5px;
    color: var(--accText);
  }
  .recent-list :global(.recent-msg) {
    font-size: 14.5px;
    line-height: 1.45;
  }
  .recent-list :global(.recent-meta) {
    font-size: 11px;
    color: var(--fg3);
  }
</style>

<script>
  import { initPlot } from './plot';
  initPlot();
</script>
