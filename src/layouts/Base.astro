---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Dock from '../components/Dock.astro';

interface Props {
  title: string;
  description?: string;
  pad?: 'home' | 'sub';
  gap?: string;
  image?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description = 'backend. money and market data.',
  pad = 'sub',
  gap: gapOverride,
  image = '/og.png',
  type = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
const padTop = pad === 'home' ? '104px' : '72px';
const padTop640 = pad === 'home' ? '56px' : '44px';
const padTop420 = pad === 'home' ? '44px' : '36px';
const gap = gapOverride ?? (pad === 'home' ? '64px' : '40px');
const gapPx = parseInt(gap, 10);
const gap640 = `${Math.max(24, Math.round(gapPx * 0.6))}px`;
const gap420 = `${Math.max(18, Math.round(gapPx * 0.45))}px`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="shifan.me" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
    <script is:inline>
      // Runs before first paint so the theme never flashes.
      try {
        var t = localStorage.getItem('shifan-theme');
      } catch (e) { var t = null; }
      document.documentElement.classList.add(t === 'light' ? 'th-light' : 'th-dark');
    </script>
  </head>
  <body>
    <main
      class="site-main"
      style={`--pad-top:${padTop};--pad-top-640:${padTop640};--pad-top-420:${padTop420};--gap:${gap};--gap-640:${gap640};--gap-420:${gap420}`}
    >
      <slot />
    </main>
    <Dock />
  </body>
</html>

<style>
  .site-main {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    padding: var(--pad-top) 40px 40px;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    box-sizing: border-box;
  }
  @media (max-width: 640px) {
    .site-main {
      padding: var(--pad-top-640) 20px 28px;
      gap: var(--gap-640);
    }
  }
  @media (max-width: 420px) {
    .site-main {
      padding: var(--pad-top-420) 16px 24px;
      gap: var(--gap-420);
    }
  }
</style>
